(import uniterm)

(defn refuses [label needle f]
  (def [ok message] (protect (f)))
  (assert (not ok) (string label " was accepted"))
  (assert (string/find needle (string message)) (string label " failed with: " message)))

(def pane {:window 7 :pane 1})
(def nan (- math/inf math/inf))

(refuses "no argument" "arity" (fn [] (uniterm/open-pane)))
(refuses "no pane" "arity" (fn [] (uniterm/open-pane :terminal)))
(refuses "a string kind" "keyword" (fn [] (uniterm/open-pane "terminal" pane)))
(refuses "a long kind" "most is" (fn [] (uniterm/open-pane (keyword (string/repeat "k" 33)) pane)))
(refuses "a pane that is a number" "must be a struct" (fn [] (uniterm/open-pane :terminal 1)))
(refuses "no pane ID" "no :pane" (fn [] (uniterm/open-pane :terminal {:window 7})))
(refuses "no window ID" "no :window" (fn [] (uniterm/open-pane :terminal {:pane 1})))
(refuses "a fractional pane" "whole number" (fn [] (uniterm/open-pane :terminal {:window 7 :pane 0.5})))
(refuses "an infinite pane" "finite" (fn [] (uniterm/open-pane :terminal {:window 7 :pane math/inf})))
(refuses "a nan window" "finite" (fn [] (uniterm/open-pane :terminal {:window nan :pane 1})))
(refuses "a negative tab" "negative" (fn [] (uniterm/open-pane :terminal {:window 7 :pane 1 :tab -1})))
(refuses "a huge pane" "too large" (fn [] (uniterm/open-pane :terminal {:window 7 :pane 9007199254740992})))
(refuses "a bad axis" "must be :row or :column" (fn [] (uniterm/open-pane :terminal pane :axis :diagonal)))
(refuses "a string axis" "must be :row or :column" (fn [] (uniterm/open-pane :terminal pane :axis "row")))
(refuses "an option with no value" "needs a value" (fn [] (uniterm/open-pane :terminal pane :axis)))
(refuses "an unknown option" "options are" (fn [] (uniterm/open-pane :terminal pane :colour :red)))
(refuses "a repeated axis" "twice" (fn [] (uniterm/open-pane :terminal pane :axis :row :axis :column)))
(refuses "a repeated directory" "twice" (fn [] (uniterm/open-pane :terminal pane :directory "/a" :directory "/b")))
(refuses "a relative directory" "absolute path" (fn [] (uniterm/open-pane :terminal pane :directory "work")))
(refuses "a dot directory" "absolute path" (fn [] (uniterm/open-pane :terminal pane :directory ".")))
(refuses "an empty directory" "empty" (fn [] (uniterm/open-pane :terminal pane :directory "")))
(refuses "a number directory" "must be a string" (fn [] (uniterm/open-pane :terminal pane :directory 5)))
(refuses "a keyword directory" "must be a string" (fn [] (uniterm/open-pane :terminal pane :directory :tmp)))
(refuses "a directory with a NUL" "NUL" (fn [] (uniterm/open-pane :terminal pane :directory "/a\0b")))
(refuses "a directory that is not UTF-8" "not UTF-8" (fn [] (uniterm/open-pane :terminal pane :directory "/\xFF")))
(refuses "a long directory" "most is" (fn [] (uniterm/open-pane :terminal pane :directory (string "/" (string/repeat "d" 1024)))))
